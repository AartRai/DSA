//https://leetcode.com/problems/find-all-anagrams-in-a-string/description/

// Store frequency of pattern characters.
// distinct_element = number of unique characters still unmatched.
//
// Process first window of size k:
// - Decrease frequency for incoming characters.
// - If a frequency becomes 0, one character is fully matched.
//
// Slide the window:
// - Remove left character: increase its frequency.
//   If frequency becomes 1, increment distinct_element.
// - Add right character: decrease its frequency.
//   If frequency becomes 0, decrement distinct_element.
//
// Whenever distinct_element == 0,
// current window is an anagram, so store its starting index.
//
// TC: O(n)
// SC: O(k)  (O(1) for fixed alphabet)


class Solution {
public:
    vector<int> findAnagrams(string s, string p) {
        vector<int> ans;

        int n = s.size();
        int k = p.size();

        if (k > n) return ans;

        unordered_map<char, int> mp;

        for (char ch : p) {
            mp[ch]++;
        }

        int distinct_element = mp.size();
        int i = 0;

        // First window
        while (i < k) {
            if (mp.find(s[i]) != mp.end()) {
                mp[s[i]]--;

                if (mp[s[i]] == 0) {
                    distinct_element--;
                }
            }
            i++;
        }

        if (distinct_element == 0) {
            ans.push_back(0);
        }

        // Sliding window
        while (i < n) {

            // Remove left character
            char left = s[i - k];
            if (mp.find(left) != mp.end()) {
                mp[left]++;

                if (mp[left] == 1) {
                    distinct_element++;
                }
            }

            // Add right character
            char right = s[i];
            if (mp.find(right) != mp.end()) {
                mp[right]--;

                if (mp[right] == 0) {
                    distinct_element--;
                }
            }

            if (distinct_element == 0) {
                ans.push_back(i - k + 1);
            }

            i++;
        }

        return ans;
    }
};

//TC : O(n)
//SC : O(1)
